<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 로그인 딥링크. 구글·카카오는 앱 안 웹뷰 로그인을 막아서 바깥
                 브라우저로 나갔다 와야 하는데, 이 문이 없으면 로그인이 브라우저에
                 남고 앱은 계속 로그아웃 상태가 된다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

        </activity>

        <!-- ── 걸려온 전화 알림 ─────────────────────────────────────────
             Capacitor 푸시 플러그인도 같은 MESSAGING_EVENT 를 노리는 서비스를
             하나 갖고 있다. 둘이 있으면 어느 쪽이 받을지 기기마다 달라져서
             전화가 울리다 말다 한다 — 운에 맡길 수 없다.
             그래서 플러그인 쪽은 떼어내고, 그 클래스를 상속한 우리 서비스
             하나만 남긴다. super 를 부르므로 플러그인 기능은 그대로 산다. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <service
            android:name="com.uroong.cbt.CallMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 보이스톡: 마이크 없이는 통화 자체가 성립하지 않는다 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 수화기(귀에 대고)·스피커 전환. 웹에서는 불가능했던 그것 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 통화·상담사 답장 알림 (안드로이드 13+ 는 런타임 동의가 필요하다) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 잠긴 화면을 뚫고 전화벨 화면을 띄운다. 안드로이드 14+ 는 이 선언이
         없으면 전체화면 알림이 그냥 헤드업 알림으로 내려앉는다 —
         자는 사람은 전화를 못 받는다. (전화 앱에만 허용되는 권한이다) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 전화벨 진동 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 배터리 최적화 예외를 '요청'할 자격. 폰이 깊이 잠들면(도즈) 푸시가
         몇 분씩 늦게 도착하는데, 전화의 유통기한은 60초다.
         강제하지 않는다 — 사용자가 거절하면 그대로 둔다. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 통화 중 화면을 꺼도 연결이 끊기지 않게 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 이어폰·블루투스로 자동 전환 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 상담사 매칭의 '내 위치' (가까운 순 정렬). 없으면 그 버튼만 안 된다 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 마이크 없는 기기(일부 태블릿)에서도 설치는 되게 — 통화만 못 쓴다 -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
